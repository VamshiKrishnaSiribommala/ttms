@{
    ViewData["Title"] = "Reset Password";
}

<div style="max-width: 450px; margin: 3rem auto;">
    <div class="card" style="border-top: 4px solid var(--warning);">
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--primary);">Password Recovery</h2>
            <p style="color: var(--text-muted); font-size: 0.85rem;">Set a new password for your account</p>
        </div>

        <form method="post" asp-action="ForgotPassword">
            <div class="form-group">
                <label class="form-label">Username</label>
                <input type="text" name="username" class="form-control" placeholder="Enter your registered username" required autofocus />
            </div>

            <div class="form-group">
                <label class="form-label">New Password</label>
                <input type="password" name="newPassword" class="form-control" placeholder="At least 6 characters" required />
            </div>

            <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <input type="password" name="confirmPassword" class="form-control" placeholder="Repeat new password" required />
            </div>

            <button type="submit" class="btn btn-warning" style="width: 100%; padding: 12px; font-weight: 700; margin-top: 1rem;">
                Update Password
            </button>
            <div style="text-align: center; margin-top: 1rem;">
                <a asp-action="Login" style="color: var(--primary); font-size: 0.9rem; text-decoration: none;">&larr; Back to Login</a>
            </div>
        </form>
    </div>
</div>
