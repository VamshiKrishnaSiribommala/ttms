@model System.Data.DataTable
@{
    var reg = (TMS.Core.Models.RegisterDefinition)ViewBag.Register;
    ViewData["Title"] = $"Logs - {reg.Title}";
}

<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem;">
    <div>
        <a asp-action="Index" style="color: var(--text-muted); font-size: 0.85rem; text-decoration: none;">&larr; Back to Directory</a>
        <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--primary); margin-top: 4px;">@reg.Title Logs</h1>
        <p style="color: var(--text-muted); font-size: 0.85rem;">Table: <code>@reg.TableName</code> &bull; @Model.Rows.Count Records Found</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <a asp-action="ExportCsv" asp-route-id="@reg.Number" class="btn btn-outline" style="font-size: 0.85rem;">📥 Export CSV</a>
        <a asp-action="Form" asp-route-id="@reg.Number" class="btn btn-primary" style="font-size: 0.85rem;">✍️ New Entry</a>
    </div>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
        @if (Model.Rows.Count == 0 || (Model.Columns.Count == 1 && Model.Columns[0].ColumnName == "Status"))
        {
            <div style="text-align: center; padding: 3rem 1rem;">
                <div style="font-size: 2.5rem; margin-bottom: 1rem;">📭</div>
                <h3 style="font-size: 1.2rem; color: var(--text-muted); font-weight: 600;">No records recorded yet</h3>
                <p style="color: #94a3b8; font-size: 0.9rem; margin-top: 4px;">Click 'New Entry' to submit the first log for this register.</p>
            </div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        @foreach (System.Data.DataColumn col in Model.Columns)
                        {
                            <th>@col.ColumnName</th>
                        }
                        <th>Dispatch</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Data.DataRow row in Model.Rows)
                    {
                        string logIdVal = row.Table.Columns.Contains("LogID") ? row["LogID"]?.ToString() ?? "" : "";
                        <tr>
                            @foreach (System.Data.DataColumn col in Model.Columns)
                            {
                                <td>
                                    @if (col.ColumnName == "LogID")
                                    {
                                        <code style="font-weight: 700; color: var(--primary);">@row[col]</code>
                                    }
                                    else
                                    {
                                        @(row[col]?.ToString() ?? "")
                                    }
                                </td>
                            }
                            <td>
                                @if (!string.IsNullOrWhiteSpace(logIdVal))
                                {
                                    <a asp-controller="Reports" asp-action="DispatchMemo" asp-route-type="Registers" asp-route-id="@reg.Number" asp-route-logId="@logIdVal" class="btn btn-outline" style="font-size: 0.75rem; padding: 4px 8px;" title="Official Memo & Mobile Dispatch">
                                        📨 Memo
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
